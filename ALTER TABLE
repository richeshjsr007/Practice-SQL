Topic. 1: ADD Column:  ALTER TABLE 
                       ADD COLUMN   
-- As statement suggest it is used for adding column.
-- Example: Add city and country column to table 

ALTER TABLE OFFICE
ADD COLUMN CITY VARCHAR(30) NOT NULL,
ADD column COUNTRY varchar(30) NOT NULL;

Topic. 2: DROP Column : ALTER TABLE
                        DROP COLUMN
-- As statement suggest it is used for DROP column.
-- Example: DROP country column FROM table 

ALTER TABLE OFFICE 
DROP COUNTRY;

Topic. 2: RENAME TABLE / COLUMN

-- Let say need to rename TABLE NAME 

 -- Two ways: 
    1. RENAME TABLE OFFICE TO OFC_ADDRESS;
    2. alter table OFC_ADDRESS
       RENAME to office;

--  Rename COLUMN 

    ALTER TABLE OFFICE
    rename column office_name to office;

Topic. 3: MODIFY COLUMN 

-- Let say we need to modify the data type for any column of a table 

ALTER TABLE OFFICE 
MODIFY COLUMN office varchar(100);

-- So previously it was VARCHAR(20) AND NOT NULL
OR
ALTER TABLE OFFICE
MODIFY COLUMN address varchar(100) default 'unknown';
-- so if we skip address column it will auto fill with defined default value.

-- Let say we need to rename as well as change teh defination / change the data type (use CHANGE)
ALTER TABLE OFFICE
CHANGE office OFC_NAME varchar(100) default 'Infotech';

