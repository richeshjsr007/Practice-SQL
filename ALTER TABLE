Topic. 1: ADD Column:  ALTER TABLE 
                       ADD COLUMN   
-- As statement suggest it is used for adding column.
-- Example: Add city and country column to table 

ALTER TABLE OFFICE
ADD COLUMN CITY VARCHAR(30) NOT NULL,
ADD column COUNTRY varchar(30) NOT NULL;

Topic. 2: DROP Column : ALTER TABLE
                        DROP COLUMN
-- As statement suggest it is used for DROP column.
-- Example: DROP country column FROM table 

ALTER TABLE OFFICE 
DROP COUNTRY;
