-- Topic 1. COUNT
-- Example 1 :- Find the total no. of books available in database 

SELECT 
    COUNT(*)
FROM
    books;

O/P= 19

-- Example 2:- Display count of author first name are there in table 

SELECT 
    COUNT(author_fname) AS 'fname count'
FROM
    books;

-- Example 3:- How any unique author first name are there in table 

SELECT 
    COUNT(DISTINCT author_fname) AS 'fname count'
FROM
    books;

-- Example 4:-  Display count of books having 'the' in their title.

SELECT 
    COUNT(*)
FROM
    books
WHERE
    title LIKE '%the%';

-- Topic 2. GROUP BY (collapses multiple rows into a single summary row)
--  Example 1:- Display count of books written by each authors by last name.

SELECT 
    author_lname, COUNT(title) AS count_of_books
FROM
    books
GROUP BY author_lname;

OR 

SELECT 
    author_lname, COUNT(title) AS count_of_books
FROM
    books
GROUP BY author_lname
ORDER BY count_of_books ;












