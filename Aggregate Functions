-- TOPIC 1. COUNT
-- Example 1 :- Find the total no. of books available in database 

SELECT 
    COUNT(*)
FROM
    books;

O/P= 19

-- Example 2:- Display count of author first name are there in table 

SELECT 
    COUNT(author_fname) AS 'fname count'
FROM
    books;

-- Example 3:- How any unique author first name are there in table 

SELECT 
    COUNT(DISTINCT author_fname) AS 'fname count'
FROM
    books;

-- Example 4:-  Display count of books having 'the' in their title.

SELECT 
    COUNT(*)
FROM
    books
WHERE
    title LIKE '%the%';

-- TOPIC 2. GROUP BY (collapses multiple rows into a single summary row)
--  Example 1:- Display count of books written by each authors by last name.

SELECT 
    author_lname, COUNT(title) AS count_of_books
FROM
    books
GROUP BY author_lname;

OR 

SELECT 
    author_lname, COUNT(title) AS count_of_books
FROM
    books
GROUP BY author_lname
ORDER BY count_of_books ;

-- TOPIC 2. MIN & MAX ( used to get minimum or  maximum value from certain column)
-- Example 1:- Earliest book realeased in which year?

SELECT 
    MIN(released_year)
FROM
    books;

-- Example 2:- What is the maximum number of pages in any book?

SELECT 
MAX(pages) Longest_book
FROM
    books;  

-- Example 3:- Find the lowest and highest alphabet author last name.

SELECT 
    MIN(author_lname), MAX(author_lname)
FROM
    books;  

-- TOPIC 3:- GROUP BY Multiple column
-- Example :- Display total no. of books written by each authors

SELECT 
    author_fname, author_lname, COUNT(*) AS book_count
FROM
    books
GROUP BY author_fname , author_lname
;

OR 

SELECT 
    CONCAT(author_fname, ' ', author_lname) AS Author,
    COUNT(*) AS book_count
FROM
    books
GROUP BY Author
;  

-- TOPIC 4:- SUB-QUERY 
-- Example 1 :- What is the title of longest book from the collection.

SELECT 
    title, pages AS pages
FROM
    books
ORDER BY pages DESC
LIMIT 1; 

OR 

SELECT 
    title, pages
FROM
    books
WHERE
    pages = (SELECT 
            MAX(pages)
        FROM
            books);

-- Example 2:- which is the earliest released book from collection.

SELECT 
    title, released_year
FROM
    books
WHERE
    released_year = (SELECT 
            MIN(released_year)
        FROM
            books);  

-- TOPIC 5:- MIN/MAX with GROUP By 
-- Example 1:- Find the year each author published their 1st book.

SELECT 
    CONCAT(author_fname, ' ', author_lname) AS Author,
    MIN(released_year)
FROM
    books
GROUP BY Author;

-- Example 2:- Find the latest and earliest year each author published their books.

SELECT 
    CONCAT(author_fname, ' ', author_lname) AS Author,
    MAX(released_year) AS latest_book,
    MIN(released_year) AS earliest_book,
    COUNT(*) AS books_written
FROM
    books
GROUP BY Author;

-- Example 3:- Find the longest page count for each author

SELECT 
    CONCAT(author_fname, ' ', author_lname) AS Author,
    MAX(pages)
FROM
    books
GROUP BY author;

