--/ 1. CONCAT / CONCATENATE (Combine dat for cleaner output)
-- Example :-
select concat('H','E','L','L','O');

-- Show author's full name. 
select 
  concat_ws('-', author_fname, author_lname) AS Author_name 
FROM 
  books;

-- / 2. CONCAT_WS (Concatenate with Seperator)

-- Show full name using seperator
select 
  concat_ws('-', author_fname, author_lname) AS Author_name 
FROM 
  books;

-- / 3. SUBSTRING  (SUBSTR) (It takes a single larger string and returns smaller portion of that string)

-- Example :- 
select substr ('Hello world',1,8) ;
O/P - 'Hello wo'

--Example 2 :-  Show only 1st 10 characters of Title 

SELECT 
  SUBSTRING(title, 1, 10) AS 'short title' 
FROM 
  books;
or 
SELECT 
  SUBSTR(title, 1, 10) AS 'short title' 
FROM 
  books;

-- / 4. COMBINING STRING FUNCTIONS - (concatenate & substring)
-- Show 1st 10 characters of Title along with release year 

select 
  concat(
    substr(title, 1, 10), 
    '-', 
    released_year
  ) AS short_title 
from 
  books;

-- Fetch initials of authors name from the books

select 
  substr(author_fname, 1, 1) AS first_initial, 
  substr(author_lname, 1, 1) As last_initial 
from 
  books;

-- Fetch initials of authors name from the books and combine them

select 
  concat(
    substr(author_fname, 1, 1), 
    substr(author_lname, 1, 1)
  ) 
from 
  books;

-- select the initials of authors name from the books, separated by a period

select 
  concat(
    substr(author_fname, 1, 1), 
    '.', 
    substr(author_lname, 1, 1), 
    '.'
  ) As author_initials 
from 
  books;

-- / 5. REPLACE (Replace parts of string) -
-- command = " REPLACE (str,from_str,to_str)"

--Example 1. - 'Lovely Day' change to 'Bad DAY'

 SELECT REPLACE('Lovely Day', 'Lovely', 'Bad');
 O/P -  'Bad DAY'

-- Example 2. - 'Car Bike Train Ship Plane' add comma seperator.

SELECT 
    REPLACE('Car Bike Train Ship Plane',
        ' ',
        ',') As vehicles;

-- Fetch title from the books and replace all spaces in the titles with underscores '_'.

   SELECT 
    REPLACE(title, ' ', '_') As title
FROM
    books;

-- / 6. REVERSE (Reverse the string order) -
-- command = " REVERSE (str)"

-- Example -  Reverse 'ABCDEFGH'

SELECT REVERSE('ABCDEFGH') AS REVERESED;

-- Reverse authors firstname from books 

SELECT 
    REVERSE(author_fname) AS author
FROM
    books;

-- Using REVERSE with CONCAT

 SELECT 
    CONCAT(author_fname, '_', REVERSE(author_fname)) AS Author_name
FROM
    books;

-- / 7. CHAR_LENGTH (Count Characters in String)
-- command = "CHAR_LENGTH(Str)" or "SELECT CHAR_LENGTH(Str)"

-- Example :-  select char_length("richesh");
   O/P = 7

-- Display books title and their charcter length from Books.

SELECT 
    title,char_length(title) AS Title_length
FROM
    books;

-- Combine CONCAT with CHAR_LENGTH 
-- Display authors last name with there character length.

SELECT 
    CONCAT(author_lname,
            ' is ',
            CHAR_LENGTH(author_lname),
            ' characters long') As author
FROM
    books;

-- / 8. UPPER(str)/ UCASE(str) and LOWER(str)/ LCASE(str) (Change a strings Case)
-- Example :- use - 'Good Day'
SELECT UPPER('Good Day'); or SELECT UCASE('Good Day');  -- O/P = 'GOOD DAY'
SELECT LOWER('Good Day'); or SELECT LCASE('Good Day'); -- O/P = 'good day'

-- /  Combine CONCAT with UCASE or LCASE 
--  Display 'I LOVE' with title and !!! from books

SELECT 
    CONCAT('I LOVE', ' ', UCASE(title), '!!!') AS books
FROM
    books;

-- / 9. Using other function 
-- A :- Instering any charcter in between string 
-- command = INSERT (str, postion, length, newstr)
-- Example :-  Inster 'there' in 'Hello mate!'

SELECT INSERT('Hello mate!', 6, 0, ' there') AS greet; 
-- (there is space '_there' & '0' denotes we're not replacing anything)

-- Example 2. Replace 'Hello mate!' to 'Hello world!'

SELECT INSERT('Hello mate!', 6, 5, ' world') AS greet; 
-- (there is space '_world' & '5' denotes we've replaced 5 char.)

-- B :- Selecting charcters from LEFT or RIGHT
-- command = LEFT (str,len); (Returns leftmost len character from string)
             RIGHT (str,len); (Returns rightmost len character from string)   
-- here str = string & len = to what length 

-- Example :-  'Practice-SQL'

SELECT LEFT('Practice-SQL', 8) As Left_char;
-- O/P =  'Practice'

SELECT RIGHT('Practice-SQL',3) As Right_char;
-- O/P = 'SQL'

-- C :- Repeat any string 
-- command = REPEAT (str,count)
-- count = no.of repate count

-- Example :-  'Ha'

SELECT REPEAT('Ha', 5) AS repeated;
-- O/P = 'HaHaHaHaHa'

-- D :- TRIM -  used to remove spaces
-- command = TRIM(str)
-- Example :-  '  OM  '

SELECT TRIM('  om  ') AS trimmed;
-- O/P = 'om'

-- Trim using "LEADING" to remove specific character from leftmost part of string
-- Example :- 'iamOMok'

SELECT TRIM(LEADING 'iam' FROM 'iamOMok') AS trimmed;
-- O/P = 'OMok'

-- Trim using BOTH to remove specific character from BOTH side of string 
-- Example : - 'iiOMii'

SELECT TRIM(BOTH 'i' FROM 'iiOMii') AS trimmed;
-- O/P = 'OM'

-- Trim using TRAILING to remove specific character from rightmost part of string 
-- Example : - 'iamOMnot'

SELECT TRIM(TRAILING 'not' FROM 'iamOMnot') AS trimmed;
-- O/P = 'iamOM'

