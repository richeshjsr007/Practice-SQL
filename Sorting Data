-- Topic 1. DISTINCT ( Display UNIQUE data from table)

-- Example :-  'Display unique last names for Authors'

SELECT DISTINCT
    (author_lname)
FROM
    BOOKS;

-- Example :- 'Display unique full names for Authors'

SELECT DISTINCT
    author_fname, author_lname
FROM
    BOOKS;

OR

SELECT DISTINCT
    CONCAT(author_fname, ' ', author_lname) as 'Full name'
FROM
    BOOKS;

-- Topic 2. ORDER BY ( Sorting O/P data from table)

-- Display all records from the books table, sorted by title.

SELECT 
    *
FROM
    books
ORDER BY TITLE;  

-- Another way - Display all records from the books table, ordered by title from Z to A.

SELECT 
    *
FROM
    books
ORDER BY title DESC;

-- Another way - Display all records from the books table, ordered by title. 

SELECT 
    *
FROM
    books
ORDER BY 2;

-- Explaination -  ORDER BY 2 - means order by '2nd Column from the SELECT query'

OR 

SELECT 
    author_lname, stock_quantity, pages, title
FROM
    books
ORDER BY 4;

--  3. ORDER BY using MULTIPLE Columns 

-- Display all records from the books table, ordered by author_fname and released year.

SELECT 
    *
FROM
    books
ORDER BY author_fname, released_year;

OR

-- Display title, author first name & released year from the books table, ordered by author first name and newest released year.

SELECT 
    title, author_fname, released_year
FROM
    books
ORDER BY author_fname , released_year DESC;

OR 

-- 4. ORDER BY using Aliases
-- Display Authors full name and sort by fullname .

SELECT 
    CONCAT(author_fname, ' ', author_lname) AS Authors
FROM
    books
ORDER BY Authors;

-- 4. Order by using LIMIT (It controls the no. of rows in the result set)
-- Example :-  Display the first 8 records from the books table, sorted by their ID.

SELECT 
    *
FROM
    BOOKS
ORDER BY BOOK_ID
LIMIT 8;

Example:-  Display the 10 earliest released books from the books table.

SELECT 
    *
FROM
    BOOKS
ORDER BY released_year
LIMIT 10
;

OR

SELECT 
    *
FROM
    BOOKS
ORDER BY book_id
LIMIT 3,5
;
-- Explanation -  In above query ORDER BY book_id LIMIT 3,5 -  means skip the first 3 rows of the sorted results and display the next 5 records. 
-- (This allows us to SLECT SUBSET in between grouping)

-- 5. Order by using LIMIT and WHERE Clause (WHERE is used as filter)
-- Display the first two records from the books table where the author's first name is 'Neil', sorted by title.

SELECT * 
FROM books 
WHERE author_fname = 'Neil' 
ORDER BY title ASC 
LIMIT 2;

