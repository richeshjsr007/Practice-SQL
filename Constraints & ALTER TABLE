-- Topic. 1: UNIQUE Constrain: The UNIQUE constraint ensures that all values in a column are completely different from one another.
-- Topic. 2: CHECK Constrain: The CHECK constraint is a tool that limits the values allowed in a column based on a specific condition.
             It acts like a strict filter: whenever you try to insert or update a row, the database checks your condition.
  create table author (
autor_name varchar(15),
age int check (age > 18)
);
desc AUTHOR;

INSERT into author (autor_name, age)
value ('David', 23);

-- Below query violates the rule.
INSERT into author (autor_name, age)
value ('DON', 16);

-- Bonus: 
CREATE TABLE palindromes (
  word VARCHAR(100) CHECK(REVERSE(word) = word)
);

-- Topic. 3: MULTIPLE Constraint: Means applying more than one database rule to a single column or table to ensure the data is perfectly clean,
             accurate, and secure

Example: -  create a table name contact with columns name and mobile_number. Also for mobile_number column constraint is that it should
            not be blank, it should be Unique and should be of 10 character only.

CREATE TABLE contact(
Name varchar(15) NOT NULL,
Mobile_number VARCHAR(10) NOT NULL UNIQUE CHECK (CHAR_LENGTH(Mobile_number) = 10) 
);

INSERT INTO CONTACT (name, mobile_number)
value ('Ram', 9876543201);


