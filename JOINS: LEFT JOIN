Topic. 1: LEFT JOIN (Also called a LEFT OUTER JOIN)
      -- It returns all rows from the left table and the matching rows from the right table, putting NULL values where there is no match.
-- Example. 1: Write query to display all the customer first and last name, order date and amount.

SELECT first_name, last_name order_date, amount
from customers c
LEFT JOIN 
orders O
ON
c.id = o.customer_id
;

-- Example. 1: Write query to display all the order date, amount, customer first and last name.

SELECT order_date, amount, first_name, last_name
from orders o
LEFT JOIN 
customers c
ON
o.customer_id = c.id
;

Topic. 2: LEFT JOIN with GROUP BY
-- Example. 1: write query to display total amount spent and orders placed by each customer.

SELECT first_name, sum(amount) AS total_spent, count(o.id) as count_of_order
from customers c
LEFT JOIN 
orders O
ON
c.id = o.customer_id
group by customer_id, first_name
;
