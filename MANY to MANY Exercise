-- Q1. Write query to diplay series title and there ratings.
-- Sol.
select title, rating from series S
    JOIN reviews R 
    ON S.id = R.series_id
    ;

-- Q2. Write query to diplay series title and there average ratings lowest to highest round by 2 decimal place.

  select title, 
    round(avg(rating),2) as AVG_Rating from series S
    JOIN reviews R 
    ON S.id = R.series_id
    group by title
    order by AVG_rating asc
    ;

-- Q3. Write query to diplay rating given by each viewers make sure to dispaly their names.

 select first_name, last_name, rating from reviewers v
    join reviews r
    ON v.id = r.reviewers_id;

-- Q4. Write query to diplay average rating given by each viewers make sure to dispaly their names.

select first_name, last_name, round(avg(rating),1) as avg_rating from reviewers v
    join reviews r
    ON v.id = r.reviewers_id
    group by first_name, last_name
    order by avg_rating
    ; 

-- Q5. Write query to diplay the series title having no reviews and name it as unreviewed.

select title as unreviewed from series s
    LEFT join reviews r
    on s.id = r.series_id
    WHERE rating is null;

-- Q6. Write query to diplay the average rating given to each genre.

select genre, round(avg(rating),2) as avg_rating from series s
    join reviews r
    on s.id=r.series_id
    group by genre
    order by avg_rating;



