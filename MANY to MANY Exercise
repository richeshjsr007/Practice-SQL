-- Q1. Write query to diplay series title and there ratings.
-- Sol.
select title, rating from series S
    JOIN reviews R 
    ON S.id = R.series_id
    ;

-- Q2. Write query to diplay series title and there average ratings lowest to highest round by 2 decimal place.

  select title, 
    round(avg(rating),2) as AVG_Rating from series S
    JOIN reviews R 
    ON S.id = R.series_id
    group by title
    order by AVG_rating asc
    ;

