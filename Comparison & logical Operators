-- TOPIC 10.  Modulus % (Used to retrive EVEN & ODD data)
   -- Example 1: write query to retrive all the data from the books that was released after year 2000 and are odd year 
SELECT 
    title, released_year
FROM
    books
WHERE
    released_year >= '2000'
        AND released_year % 2 = 1;

-- Example 2: write query to retrive all the data from the books that was released after year 2000 and are even year 
SELECT 
    title, released_year
FROM
    books
WHERE
    released_year >= '2000'
        AND released_year % 2 = 0;

-- TOPIC 11. CASE Function (It is used whenever we need to add conditional "if-then-else" logic to our queries)
   -- Example 1: Write an SQL query to display the title and release year of all books, along with a custom column named "Type" 
                 that classifies them as 'Modern' if released in or after the year 2000, and '20th Century' otherwise.

  SELECT 
    title,
    released_year,
    CASE
        WHEN released_year >= '2000' THEN 'Modern'
        ELSE '20th Century'
    END AS Type
FROM
    books;

   -- Example 2: Write an SQL query to display the loan ID, customer ID, and loan amount, along with a custom column named "Type" 
                 that classifies loans as 'High Ticket' if the amount is 500,000 or greater, and 'Small Ticket' otherwise.

     SELECT 
    loan_id,
    customer_id,
    loan_amount,
    CASE
        WHEN loan_amount >= '500000' THEN 'High Ticket'
        ELSE 'Small Ticket'
    END Type
FROM
    loans;

