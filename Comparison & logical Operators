-- TOPIC 1. NOT EQUAL  ( != )
   -- Example 1:- Print title for books from table not released in 2017.

      SELECT 
    title
FROM
    books
WHERE
    released_year != 2017;

   -- Example 2:- Print title & authors lastname for books not written by authors lastname as 'harris'.

      SELECT 
    title, author_lname
FROM
    books
WHERE
    author_lname != 'harris';

-- TOPIC 2. NOT LIKE 
   --  NOT LIKE is a text-filtering operator that excludes rows matching a specific search pattern while keeping everything else.
   -- The NOT LIKE operator is used to filter database records by filtering out specific text patterns. It does the exact opposite
      of the LIKE operator; it finds rows that do not match the text structure you provide.
   -- It is heavily used alongside wildcards to eliminate unwanted data:
      -- % (Percent sign): Represents zero, one, or multiple characters.
      -- _ (Underscore): Represents a single, individual character.

   --  Example 1:- Print the title of those books which doesn't have space in there title.

       SELECT 
    title
FROM
    books
WHERE
    title NOT LIKE '% %'; 

--  Example 2:- Print the title of the books, where authors name does not starts with 'DA'.

    SELECT 
    title
FROM
    books
WHERE
    author_fname NOT LIKE 'DA%'; 

 -- Example 3:- Print the title of those books, that does not contain letter 'e'.

    SELECT 
    title
FROM
    books
WHERE
    title NOT LIKE '%e%';

 -- Example 4:- Print the title of those books, that does not contain word 'the'.

     SELECT 
    title
FROM
    books
WHERE
    title NOT LIKE '%the%';

-- TOPIC 3. GREATER THAN ('>')

   -- Example 1:- Print title and pages for those books, that has more tha 100 pages.

      SELECT 
    TITLE, PAGES
FROM
    books
WHERE
    PAGES > 100;

























