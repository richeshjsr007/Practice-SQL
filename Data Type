-- TOPIC 6 :- CURDATE, CURTIME, NOW

   -- CURDATE() :- Captures current CALENDAR DATE only.
      FORMAT :- YYYY-MM-DD
   -- CURTIME() :- Captures current CLOCK TIME only.
      FORMAT :- HH:MM:SS
   -- NOW() :-  Captures current complete snapshot of both DATE and TIME COMBINED.
      FORMAT :- YYYY-MM-DD HH:MM:SS

SELECT CURDATE(), CURTIME(), NOW();
-- Let say insert new row in People table using CURDATE(), CURTIME() & NOW()

INSERT INTO people (name, birthdate, birthtime, birthdt)
VALUES ('Emmy', current_date(), curtime(), now());

-- TOPIC 7 :- DATE Functions - DAYNAME(date), DAY(date) / DAYOFMONTH(date), DAYOFWEEK(date), DAYOFYEAR(date)

   -- DAYNAME(date) -  Returns the name of the weekday for date.
   -- MONTHNAME(date) - Returns the full name of the month for date.
   -- DAY(date) / DAYOFMONTH(date) - Returns the day of the month for date, in the range 1 to 31.
   -- DAYOFWEEK(date) - Returns the weekday index for date (1 = Sunday, 2 = Monday, …, 7 = Saturday).
   -- DAYOFYEAR(date) - Returns the day of the year for date, in the range 1 to 366.

-- Example :- Display the DAYNAME, DAYOFWEEK, DAYOFMONTH, DAYOFYEAR from date of birth of each people alomng with name .

SELECT 
    name,
    birthdate,
    DAYNAME(birthdate) as Day_name,
    MONTHNAME(birthdate) as Month_name,
    DAYOFWEEK(birthdate) as Day_week,
    DAYOFMONTH(birthdate) as Day_month,
    DAYOFYEAR(birthdate) as Day_year
FROM
    people;

-- TIME Functions -  hour(), minute(), second(), microsecond()

-- Example :- Display Hour, minute and seconds along with name from peoples table.

SELECT 
    NAME,
    DAY(birthdt),
    HOUR(birthdt),
    MINUTE(birthdt),
    SECOND(birthdt)
FROM
    people; 

-- TOPIC 8 :- Date Formatting -  DATE_FORMAT(date, format)

   -- %a - Abbreviated weekday name (Sun..Sat)
   -- %b - Abbreviated month name (Jan..Dec)
   -- %D - Day of the month with English suffix (0th, 1st, 2nd, 3rd, …)
   -- %H - Hour (00..23) - 24 hour format
   -- %M - Month name (January..December)
   -- %r - Time, 12-hour (hh:mm:ss followed by AM or PM)

SELECT 
    birthdt, DATE_FORMAT(birthdt, '%H:%i')
FROM
    people;

SELECT 
    birthdate, DATE_FORMAT(birthdate, '%a %b %D')
FROM
    people;

SELECT 
    birthdt, DATE_FORMAT(birthdt, 'BORN ON: %r')
FROM
    people;

-- TOPIC 9 :- Date Difference -  DATEDIFF()/ DATEDIFF(expr1,expr2)

   --  DATEDIFF() returns expr1 − expr2 expressed as a value in Day's from one date to the other.
-- (Summary -  DATEDIFF() simply takes two dates and subtracts and gives the result)
   -- Example :- SELECT DATEDIFF('2007-12-31 23:59:59','2007-12-30');
              -> 1
                 SELECT DATEDIFF('2010-11-30 23:59:59','2010-12-31');
              -> -31
   -- Example :- Let's say we've last repayment date and we need the no. of day lapsed from last payment date.

                 SELECT 
    payment_date, DATEDIFF(CURDATE(), payment_date) AS gap
FROM
    repayments;

-- Topic 10 :-  DATE_ADD(date,INTERVAL expr unit), DATE_SUB(date,INTERVAL expr unit)

   -- DATE_ADD(date,INTERVAL expr unit) - Lets say someone took loan to calculat the Loan end date depending on duration.
      
      SELECT 
    DATE_ADD(loan_date, INTERVAL 6 YEAR) AS LOAN_END_DATE
FROM
    LOANS;

   -- DATE_SUB(date,INTERVAL expr unit) - 

      SELECT 
    DATE_SUB(loan_date, INTERVAL 6 YEAR) AS LOAN_END_DATE
FROM
    LOANS;

